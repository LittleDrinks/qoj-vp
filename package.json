{
  "name": "qoj-vp-release-tools",
  "private": true,
  "scripts": {
    "lint:firefox": "web-ext lint --source-dir src/firefox --self-hosted --no-config-discovery",
    "build:board": "node scripts/build/build_board.mjs",
    "test:js": "node --test tests/unit/test_*.cjs",
    "test:py": "PYTHONPATH=src python3 -m unittest discover -s tests/unit -t .",
    "check": "npm run build:board && npm run lint:firefox && npm run test:js && npm run test:py"
  },
  "devDependencies": {
    "bcp-47-match": "2.0.3",
    "bignumber.js": "9.3.1",
    "classnames": "2.5.1",
    "color": "4.2.3",
    "esbuild": "0.25.12",
    "less": "4.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "semver": "7.7.3",
    "textcolor": "1.0.2",
    "web-ext": "10.8.0"
  },
  "engines": {
    "node": ">=24"
  }
}
